{
  "name": "cache-me-web",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run theme:check && tsc --noEmit && vite build",
    "lint": "oxlint src tests",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "theme:build": "astryx theme build src/theme/cacheMeTheme.ts --out src/theme/cache-me.css",
    "theme:check": "astryx theme build src/theme/cacheMeTheme.ts --out src/theme/cache-me.css --check"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@stylexjs/stylex": "0.19.0",
    "3d-force-graph": "1.80.1",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three-spritetext": "1.10.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "lightningcss": "1.33.0",
    "linkedom": "0.18.15",
    "mediainfo.js": "0.3.9",
    "oxlint": "1.94.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
